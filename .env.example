# chatMCD — copy to .env and fill in. .env is gitignored and never leaves the box.

# ---- Hugging Face ---------------------------------------------------------
# The ONLY place this token exists. It is never rendered into a page, never
# returned by an endpoint, and never handed to the WordPress plugin.
# A token is REQUIRED even for a public Space. The anonymous ZeroGPU quota is
# small, counted per source IP, and a handful of recruiters would exhaust it.
#
# Know what it looks like when it runs out, because it does not look like an
# error: the Space answers `event: error` with a *null* payload, gradio_client
# reports Status.FINISHED with no exception, and the Space's own log stays empty
# because the function never ran. The same question from a different IP answers
# perfectly in the same second. chatmcd/hf_client.py now catches the empty
# completion and says so, but only a token actually fixes it.
#
# A read-scoped token is enough. Do not put a write-scoped token on a
# public-facing server.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_SPACE_ID=Dellboy/chatmcd-api
HF_TIMEOUT=180

# Ping the Space on this interval so nobody lands on a 40-second cold start.
KEEPWARM_ENABLED=1
KEEPWARM_SECONDS=600

# ---- Generation -----------------------------------------------------------
TEMPERATURE=0.7
TOP_P=0.9
REPETITION_PENALTY=1.05
MAX_NEW_TOKENS=1200
MAX_HISTORY_TURNS=8

# ---- Retrieval ------------------------------------------------------------
# Read by /api/health for reporting only; the Space is what actually switches
# retrieval on, through its own RAG_ENABLED variable.
RAG_ENABLED=0

# ---- Web ------------------------------------------------------------------
SECRET_KEY=change-me
RATE_LIMIT="20 per minute"
# memory:// is per-worker. With two gunicorn workers that is effectively double
# the stated limit. Point this at redis://127.0.0.1:6379 if that ever matters.
RATE_LIMIT_STORAGE=memory://
ALLOWED_ORIGINS=https://marcdeller.com,https://www.marcdeller.com,https://mdeller.com,https://www.mdeller.com,https://chatmcd.mdeller.com
FRAME_ANCESTORS='self',https://marcdeller.com,https://*.marcdeller.com,https://mdeller.com,https://*.mdeller.com

DB_PATH=/opt/chatmcd/var/chatmcd.sqlite
LOG_QUESTIONS=1
APP_VERSION=0.1.0
# The résumé the header links to. Update when a newer PDF is published.
RESUME_URL=https://marcdeller.com/wp-content/uploads/2026/07/marc_deller_resume_july_2026.pdf

# ---- gunicorn -------------------------------------------------------------
BIND_ADDR=127.0.0.1:8010
WEB_WORKERS=2
WEB_THREADS=8
WEB_TIMEOUT=300
LOG_LEVEL=info

# ---- deploy ---------------------------------------------------------------
DROPLET_SSH=root@your.droplet
DROPLET_PATH=/opt/chatmcd
SERVER_NAME=chatmcd.mdeller.com
# SSH_KEY=~/.ssh/id_ed25519

# ---- Daily usage digest ---------------------------------------------------
# scripts/daily_digest.py emails a summary of what visitors asked and what they
# were told. Run from cron on the droplet.
#
# NOT SMTP. DigitalOcean blocks outbound 25, 465, 587 and 2525 on this droplet,
# so no mail client can send from it at all: measured, all four refuse a TCP
# connection while api.resend.com:443 accepts one. The digest posts to a
# transactional email API over 443 instead.
#
# resend.com is the default: free for 100 mails a day, and it will send from
# onboarding@resend.dev without a verified domain, which is enough for a digest
# to one address. Verify marcdeller.com there to send as marc@marcdeller.com.
DIGEST_TO=marc@marcdeller.com
# The From has to sit on a domain the provider has verified, which need not be
# the address you actually read: hence the reply-to. Without a verified domain,
# resend will still send from onboarding@resend.dev to your own account address.
DIGEST_FROM=Marc C. Deller <marc@mdeller.com>
DIGEST_REPLY_TO=marc@marcdeller.com
MAIL_PROVIDER=resend
RESEND_API_KEY=
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=

# Resolve visitor addresses to a country and city, in one batch call at digest
# time, for the few addresses that actually asked something. 0 turns it off.
GEO_LOOKUP=1

